# ---------------------------------------------------------------------
# Meridian dashboard - committed defaults.
#
#   npm install
#   npm run dev            <- the dashboard on :3000
#
# THIS FILE IS IN GIT, and this whole repository is public. Worse, Vite
# compiles every VITE_ variable straight into the JavaScript it ships to
# the browser, so a secret here is a secret on every visitor's screen.
# Nothing sensitive belongs in this file or in .env.local.
#
# .env.local (gitignored) overrides any line below on your own machine.
# ---------------------------------------------------------------------

# Port for the dev server.
VITE_PORT=3000

# Where `npm run dev` forwards /api while you develop. In production there
# is no dev server: vercel.json rewrites /api to the deployed API instead,
# which is what keeps the dashboard and the API on one origin.
VITE_API_PROXY=http://localhost:8080
